{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handtime-camera",
  "compatibility_date": "2026-11-23",
  "routes": [
    {
      "pattern": "photobooth.wadjah.my.id",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist"
  }
}
